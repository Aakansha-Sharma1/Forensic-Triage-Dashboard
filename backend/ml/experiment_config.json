  "weighting_policy": {
    "mechanism": "sample_weight_only",
    "estimator_class_weight": null,
    "double_weighting_prohibited": true,
    "normalization": "sum_to_n_train_mean_1.0",
    "regimes": [
      {
        "name": "class_weighted",
        "formula": "n_train / (2 * n_train_class)",
        "description": "Inverse class-frequency sample weights computed on the pooled training partition only; total weight sums to n_train (mean 1.0)."
      },
      {
        "name": "scenario_equalized_class_weighted",
        "formula": "n_train / (2 * n_train_scenarios * n_scenario_class)",
        "description": "Each training scenario receives equal total weight (n_train / n_train_scenarios), split equally between normal (0) and attack_associated (1) within each scenario, computed on the training partition only; total weight sums to n_train (mean 1.0)."
      }
    ]
  },
